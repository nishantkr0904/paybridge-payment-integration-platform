# Application
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=paybridge
MYSQL_USER=paybridge
MYSQL_PASSWORD=change_me

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Authentication
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Webhooks
WEBHOOK_SIGNING_SECRET=change_me

# AI & LLM Configuration (AI-001 / BT-B1 / E1)
AI_ENABLED=false
LLM_PROVIDER=mock
# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
# For Gemini (Google AI Studio OpenAI-Compatible endpoint):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_DIAGNOSIS_MODEL=gemini-3.6-flash
GEMINI_DECISION_MODEL=gemini-3.1-pro-preview
# For OpenRouter (OpenRouter OpenAI-Compatible endpoint for Gemini):
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DIAGNOSIS_MODEL=google/gemini-3.6-flash
OPENROUTER_DECISION_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_SUMMARISATION_MODEL=google/gemini-3.6-flash
# Optional OpenRouter token budget overrides (defaults: diagnosis=1600, decision=1600, summarisation=800):
# OPENROUTER_MAX_TOKENS=1600
# OPENROUTER_DIAGNOSIS_MAX_TOKENS=1600
# OPENROUTER_DECISION_MAX_TOKENS=1600
# For OmniRoute (Local OpenAI-Compatible Multi-Provider AI Gateway):
# OMNIROUTE_API_KEY=your_omniroute_api_key_here
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_DIAGNOSIS_MODEL=antigravity/gemini-3.6-flash-low
# OMNIROUTE_DECISION_MODEL=antigravity/gemini-3.1-pro-low
# OMNIROUTE_SUMMARISATION_MODEL=antigravity/gemini-3.6-flash-low
LLM_TIMEOUT_MS=20000
LLM_MAX_CONCURRENCY=10
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_MS=30000
LLM_MODEL_DIAGNOSIS=gpt-4o-mini
LLM_MODEL_DECISION=gpt-4o
LLM_MODEL_SUMMARISATION=gpt-4o-mini
